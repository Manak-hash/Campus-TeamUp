# ====================================================================
# Campus TeamUp - Backend Environment Configuration
# ====================================================================
# Copy this file to .env and update values for your local setup
# .env file innside .gitignore so no commit to git!

# --------------------------------------------------------------------
# Database Configuration
# --------------------------------------------------------------------
# Absolute path to SQLite database file
# Use forward slashes on Linux/Mac, backslashes on Windows
# Example: DB_PATH="C:/Projects/Campus-TeamUp/backend/database/campus-teamup.db"
DB_PATH="./database/campus-teamup.db"

# --------------------------------------------------------------------
# Application Environment
# --------------------------------------------------------------------
# Environment mode: development or production
APP_ENV=development

# Enable detailed error messages and stack traces
# Set to 'false' in production for security
APP_DEBUG=true

# --------------------------------------------------------------------
# CORS Configuration
# --------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
# Add your local development ports and production domains
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --------------------------------------------------------------------
# Session Configuration
# --------------------------------------------------------------------
# Session lifetime in seconds (default: 3600 = 1 hour)
SESSION_LIFETIME=3600

# --------------------------------------------------------------------
# File Upload Configuration
# --------------------------------------------------------------------
# Maximum file upload size (affects avatar uploads)
MAX_UPLOAD_SIZE=10M

# Allowed file types for uploads (comma-separated MIME types)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# --------------------------------------------------------------------
# Security Settings
# --------------------------------------------------------------------
# Application encryption key for sensitive data
# Generate a secure key using: openssl rand -base64 32
APP_KEY=base64:generate-secure-key-with-openssl-rand-base64-32