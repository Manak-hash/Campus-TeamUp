{
    "name": "campus-teamup/backend",
    "description": "Campus TeamUp REST API",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "php-di/php-di": "^7.1",
        "slim/psr7": "^1.0",
        "slim/slim": "^4.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "CampusTeamUp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CampusTeamUp\\Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    }
}
